{
	"name": "supabase-jump",
	"version": "1.2.0",
	"description": "Obsidian plugin that syncs your vault with your own Supabase project",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"supabase",
		"sync",
		"realtime",
		"backup"
	],
	"author": "Brians Tjipto",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/brianstm/obsidian-supabase-jump.git"
	},
	"bugs": {
		"url": "https://github.com/brianstm/obsidian-supabase-jump/issues"
	},
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "^1.14.4",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.1"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.119.2",
		"yjs": "^13.6.33"
	}
}
